{
  "name": "petitionu",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "dev": "bun run --filter '@petitionu/server' --filter '@petitionu/web' dev",
    "build": "bun run --filter '@petitionu/web' build && bun run --filter '@petitionu/server' build",
    "format": "bun run --filter '*' format",
    "test-db": "scripts/test-db.sh"
  }
}
