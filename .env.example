PHX_SERVER=true
PHX_HOST=petition.your-campus.edu
PORT=4000
DATABASE_URL=postgresql://petitionu:REPLACE_ME@database:5432/petitionu
DATABASE_SSL=true
POOL_SIZE=10
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=

# Effect server (apps/server). The Phoenix variables above go away when the Elixir app is removed.
PUBLIC_HOST=petition.your-campus.edu
# Mail uses RESEND_API_KEY, MAIL_FROM (a plain address, sent as "PetitionU <MAIL_FROM>") and
# SUPPORT_EMAIL (reply-to) from above. Without RESEND_API_KEY, mail is logged when
# NODE_ENV=development and refused otherwise.
# Required, at least 32 characters each. Generate each with: openssl rand -base64 48
BETTER_AUTH_SECRET=
CSRF_SECRET=
# Auth rate limits are per client address, read from X-Forwarded-For when it holds exactly one
# address. Run the app behind a proxy that sets that header (Cloudflare Tunnel, Railway).
# Optional: base URL of an OpenTelemetry collector. Export is off when unset.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional: where the built web app lives. Defaults to apps/web/dist next to the server.
WEB_DIST_DIR=

# Docker Compose (compose.yaml). Compose builds DATABASE_URL from POSTGRES_PASSWORD and
# overrides DATABASE_URL, DATABASE_SSL and PORT above for the migrate and app services.
POSTGRES_PASSWORD=
# Cloudflare Tunnel token from the Zero Trust dashboard (Networks > Tunnels).
TUNNEL_TOKEN=
