# See docs/deployment.md for every variable.
PUBLIC_HOST=petition.your-campus.edu
PORT=4000
DATABASE_URL=postgresql://petitionu:REPLACE_ME@database:5432/petitionu
DATABASE_SSL=true
POOL_SIZE=10
# Required, at least 32 characters each. Generate each with: openssl rand -base64 48
BETTER_AUTH_SECRET=
CSRF_SECRET=
# Required outside NODE_ENV=development. MAIL_FROM is a plain address, sent as
# "PetitionU <MAIL_FROM>"; SUPPORT_EMAIL is the reply-to mailbox.
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=
# Header with the client's address, for per-client auth rate limits. Defaults to
# x-forwarded-for (counted only when it holds one address). Behind Cloudflare: cf-connecting-ip,
# which the Compose stack sets itself.
# CLIENT_IP_HEADER=cf-connecting-ip
# Optional: base URL of an OpenTelemetry collector. Export is off when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional: where the built web app lives. Defaults to apps/web/dist next to the server.
# WEB_DIST_DIR=

# Docker Compose (compose.yaml). Compose builds DATABASE_URL from POSTGRES_PASSWORD and
# overrides DATABASE_URL, DATABASE_SSL and PORT above for the migrate, app and operator services.
POSTGRES_PASSWORD=
# Cloudflare Tunnel token from the Zero Trust dashboard (Networks > Tunnels).
TUNNEL_TOKEN=
