{
  "name": "@petitionu/web",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/vite": "4.1.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "heroicons": "2.2.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tailwindcss": "4.1.7",
    "typescript": "^5.9",
    "vite": "6.4.5"
  },
  "dependencies": {
    "@petitionu/domain": "workspace:*",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "motion": "13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:tooling && bun run test:petitions && bun run test:comments && bun run test:auth && bun run test:profile && bun run test:wording && bun run test:bundle-size && bun run size",
    "test:tooling": "node tools/verify-tooling.mjs",
    "test:petitions": "bun test tests/petition-mutations.test.mjs",
    "test:comments": "bun test tests/petition-comments.test.tsx",
    "test:auth": "bun test tests/auth-pages.test.tsx",
    "test:profile": "bun test tests/profile-password.test.tsx",
    "test:wording": "bun test tests/ui-wording.test.tsx",
    "test:bundle-size": "bun test tests/bundle-size.test.mjs",
    "size": "vite build && node tools/check-bundle-size.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
