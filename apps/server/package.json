{
  "name": "@petitionu/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development PORT=${PORT:-4100} node --watch src/serve.ts",
    "serve": "node dist/serve.js",
    "migrate": "node dist/migrate.js",
    "operator": "node dist/operator.js",
    "seed": "node src/seed.ts",
    "build": "bun build src/serve.ts src/migrate.ts src/operator.ts --target=node --format=esm --outdir=dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/sql-pg": "4.0.6",
    "@petitionu/domain": "workspace:*",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.14",
    "effect": "4.0.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "^5.9",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
